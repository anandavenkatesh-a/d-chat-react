<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml (DEBUG VARIANT ONLY)

  Android uses this file INSTEAD OF src/main/res/xml/network_security_config.xml
  for debug builds only. Adds cleartext exceptions for the Metro dev
  server on top of everything the release config already has (the
  .onion exception applies in both debug and release, since real
  registration/chat traffic goes through it regardless of build type).
-->
<network-security-config>

    <!-- Local Metro dev server — debug builds only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain> <!-- Android emulator's host loopback -->
        <!-- Known dev machine IPs seen so far — add new ones here as needed -->
        <domain includeSubdomains="false">192.168.0.103</domain>
        <domain includeSubdomains="false">192.168.0.107</domain>
        <domain includeSubdomains="false">192.168.0.101</domain>
    </domain-config>

    <!-- Relay's .onion hidden service — same as release, see main config
         for the full explanation. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">zqnfgm3nty47hqxod4h5e53t3m6e3sfsp7e277wt7kjj7bznymjn4oid.onion</domain>
    </domain-config>

    <!-- Legacy clearnet Railway domain — still pinned even in debug
         builds, so cert-pinning behavior stays testable. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">d-chat-relay-server-production.up.railway.app</domain>
        <pin-set expiration="2027-01-01">
            <pin digest="SHA-256">hORJtOUv6S5sVpxykVdj7ceRoUfeLhICfOGA0n68co0=</pin>
            <pin digest="SHA-256">brzvtCELCIZUo4sD/qPX0ccRtPsd3DY6RfmxpOU9oB4=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

</network-security-config>
