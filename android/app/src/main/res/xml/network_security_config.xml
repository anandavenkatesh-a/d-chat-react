<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml

  Pins the relay server's TLS certificate for the clearnet Railway
  domain, and separately permits cleartext specifically for the
  relay's .onion hidden service address — Tor addresses legitimately
  use plain ws:// at the OS/network-stack level, since Tor provides
  its own encryption and authentication (via the hidden service's
  Ed25519 keypair) at a layer BELOW what Android's cleartext policy
  can see. Without an explicit exception here, Android blocks the
  connection outright with "CLEARTEXT communication ... not permitted"
  before it ever reaches Tor's SOCKS proxy.

  Cleartext remains disabled for everything else, no exceptions.
-->
<network-security-config>

    <!-- Relay's .onion hidden service — cleartext permitted, no TLS/
         pinning needed (Tor's own protocol already authenticates this
         connection end-to-end). Update this domain if the .onion
         address ever changes (e.g. hidden service key rotation). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">zqnfgm3nty47hqxod4h5e53t3m6e3sfsp7e277wt7kjj7bznymjn4oid.onion</domain>
    </domain-config>

    <!-- Legacy clearnet Railway domain — still pinned, in case it's
         ever used again as a fallback. Harmless to leave in place;
         has no effect once the app only ever connects to the .onion
         address above. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">d-chat-relay-server-production.up.railway.app</domain>
        <pin-set expiration="2027-01-01">
            <pin digest="SHA-256">hORJtOUv6S5sVpxykVdj7ceRoUfeLhICfOGA0n68co0=</pin>
            <pin digest="SHA-256">brzvtCELCIZUo4sD/qPX0ccRtPsd3DY6RfmxpOU9oB4=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

</network-security-config>
